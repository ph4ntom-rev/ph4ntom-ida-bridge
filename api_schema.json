{
  "meta": {
    "name": "ph4ntom IDA Bridge",
    "version": "6.4.0",
    "base_url": "http://127.0.0.1:13370",
    "description": "Selected IDA Pro 9.5+ analysis, decompilation, class modeling, and dynamic debugging operations exposed via REST. Addresses accept hex strings or nonnegative JSON integers. Responses are JSON except the SSE event stream."
  },
  "system_prompt": "You are an expert reverse engineering AI agent with direct programmatic access to IDA Pro via the ph4ntom Bridge HTTP API. You can read disassembly, decompile functions, inspect types, modify the database, and run the debugger. Always use structured API calls when a dedicated endpoint exists. The /api/exec endpoint is disabled by default and may only be used when the user has explicitly enabled dynamic execution. When analyzing binaries: 1) Start with /api/info to understand the target. 2) Use /api/functions-page to browse functions. 3) Decompile interesting functions and analyze their ctree/microcode. 4) Follow cross-references to map call chains. 5) Rename and comment as you discover functionality. 6) Use /api/batch for bulk mutations. Verify hypotheses with xrefs, strings, and call graphs before drawing conclusions.",
  "capabilities": [
    "Decompile supported functions to C pseudocode when Hex-Rays is available",
    "Get AST (ctree) of decompiled functions for pattern matching",
    "Get microcode IR for deobfuscation analysis",
    "Read/write bytes, patch binary",
    "Rename functions, variables; set types and comments",
    "Create/modify/delete structs, enums, types",
    "Search by name, byte pattern, text, strings",
    "Navigate cross-references (code + data, including exact xrefs in IDA 9.5+)",
    "Inspect vtables, call graphs, basic blocks (CFG), and IDA 9.5+ language-neutral classes",
    "Full dynamic debugger control: backend selection, process/thread control, conditional/hardware breakpoints & watchpoints, stepping, registers, live memory map & search, instruction/function/basic-block tracing, exception handling, and event logs",
    "Optionally execute IDAPython scripts (/api/exec), debugger CLI commands (/api/dbg/cmd), and target Appcalls (/api/dbg/appcall) when explicitly enabled",
    "Batch mutations with preview and compensating rollback for supported name/comment operations",
    "Manage segments, type libraries, bookmarks, and decompiler timeout"
  ],
  "endpoints": {
    "read": [
      {"method":"GET","path":"/api/ping","desc":"Health check","params":[],"returns":"status, version"},
      {"method":"GET","path":"/api/info","desc":"Binary metadata: filename, processor, bitness, entry point, address range","params":[],"returns":"filename, processor, bitness, entry_point, min_ea, max_ea, hexrays_available"},
      {"method":"GET","path":"/api/functions","desc":"List all functions (max 5000)","params":[],"returns":"functions[{ea,name,size}], total, truncated"},
      {"method":"GET","path":"/api/functions-page","desc":"Paginated function list","params":[{"name":"offset","type":"int","default":0},{"name":"limit","type":"int","default":500}],"returns":"functions[], offset, limit, returned, total"},
      {"method":"GET","path":"/api/function/<ea>/pseudocode","desc":"Decompile function to C pseudocode","params":[{"name":"ea","in":"path"}],"returns":"ea, name, pseudocode, local_vars[{name,type,is_arg}]"},
      {"method":"GET","path":"/api/function/<ea>/disasm","desc":"Disassembly listing","params":[{"name":"ea","in":"path"}],"returns":"ea, name, disasm[{ea,text}]"},
      {"method":"GET","path":"/api/function/<ea>/xrefs-to","desc":"Cross-references TO this address","params":[{"name":"ea","in":"path"}],"returns":"xrefs_to[{from_ea,from_func,type}], count"},
      {"method":"GET","path":"/api/function/<ea>/xrefs-from","desc":"Cross-references FROM this function","params":[{"name":"ea","in":"path"}],"returns":"xrefs_from[{to_ea,to_func,type}], count"},
      {"method":"GET","path":"/api/function/<ea>/details","desc":"Detailed function info: prototype, flags, frame","params":[{"name":"ea","in":"path"}],"returns":"ea, name, size, flags, prototype, comment, frame_size"},
      {"method":"GET","path":"/api/function/<ea>/call-graph","desc":"Recursive call graph","params":[{"name":"ea","in":"path"},{"name":"depth","type":"int","default":3}],"returns":"tree of {ea, name, calls[], call_count}"},
      {"method":"GET","path":"/api/function/<ea>/basic-blocks","desc":"Control flow graph (basic blocks)","params":[{"name":"ea","in":"path"}],"returns":"blocks[{start,end,size,successors,predecessors}]"},
      {"method":"GET","path":"/api/function/<ea>/stack-vars","desc":"Stack variables","params":[{"name":"ea","in":"path"}],"returns":"stack_vars[{name,offset,size}]"},
      {"method":"GET","path":"/api/function/<ea>/args","desc":"Function arguments from decompiler","params":[{"name":"ea","in":"path"}],"returns":"args[{name,type,index}]"},
      {"method":"GET","path":"/api/function/<ea>/comment","desc":"Read all comments at address","params":[{"name":"ea","in":"path"}],"returns":"comment, repeatable_comment, func_comment"},
      {"method":"GET","path":"/api/function/<ea>/ctree","desc":"Hex-Rays AST (ctree) as JSON. Each node has kind(insn/expr), op, ea, dtype. Expressions include value/string/obj_ea/var_name/call_target where applicable.","params":[{"name":"ea","in":"path"}],"returns":"ctree[{kind,op,ea,dtype,...}], count"},
      {"method":"GET","path":"/api/function/<ea>/lvar-map","desc":"Full local variable map with types, register/stack info","params":[{"name":"ea","in":"path"}],"returns":"lvars[{idx,name,type,is_arg,is_stk,is_reg,width}]"},
      {"method":"GET","path":"/api/function/<ea>/microcode","desc":"Microcode IR listing. Maturity: 0=PREOPT..7=LVARS. Higher = more optimized.","params":[{"name":"ea","in":"path"},{"name":"maturity","type":"int","default":7}],"returns":"microcode[{block,ea,text}], count"},
      {"method":"GET","path":"/api/function/<ea>/callers","desc":"Functions that call this function","params":[{"name":"ea","in":"path"}],"returns":"callers[{ea,name,call_site}]"},
      {"method":"GET","path":"/api/function/<ea>/callees","desc":"Functions called by this function","params":[{"name":"ea","in":"path"}],"returns":"callees[{ea,name,call_site}]"},
      {"method":"GET","path":"/api/function/<ea>/strings-used","desc":"String constants referenced by this function","params":[{"name":"ea","in":"path"}],"returns":"strings[{ea,ref_from,value}]"},
      {"method":"GET","path":"/api/strings","desc":"Strings in binary (paginated)","params":[{"name":"filter","type":"regex","optional":true},{"name":"offset","type":"int","default":0},{"name":"limit","type":"int","default":2000},{"name":"start","type":"string","optional":true},{"name":"end","type":"string","optional":true}],"returns":"strings[{ea,module_rva,value,length}], offset, limit, returned, total, truncated"},
      {"method":"GET","path":"/api/imports","desc":"Imported functions grouped by module","params":[],"returns":"imports{module:[{ea,name,ordinal}]}"},
      {"method":"GET","path":"/api/exports","desc":"Exported functions","params":[],"returns":"exports[{ea,name,ordinal}]"},
      {"method":"GET","path":"/api/segments","desc":"Memory segments","params":[],"returns":"segments[{ea,end_ea,name,size,perm}]"},
      {"method":"GET","path":"/api/structs","desc":"All defined structures","params":[],"returns":"structs[{id,name,size}]"},
      {"method":"GET","path":"/api/struct/<name>","desc":"Structure members","params":[{"name":"name","in":"path"}],"returns":"members[{name,offset,size,type}]"},
      {"method":"GET","path":"/api/enums","desc":"All enums","params":[],"returns":"enums[{id,name,count}]"},
      {"method":"GET","path":"/api/enum/<name>","desc":"Enum members","params":[{"name":"name","in":"path"}],"returns":"members[{name,value}]"},
      {"method":"GET","path":"/api/names","desc":"Named items","params":[{"name":"filter","optional":true}],"returns":"names[{ea,name}]"},
      {"method":"GET","path":"/api/search-func/<name>","desc":"Find function by name (partial match)","params":[{"name":"name","in":"path"}],"returns":"results[{ea,name}]"},
      {"method":"GET","path":"/api/search-bytes/<pattern>","desc":"Search byte pattern. Use ?? for wildcards. Example: E8 ?? ?? ?? ?? 48 8B","params":[{"name":"pattern","in":"path"}],"returns":"results[{ea,func,func_ea}]"},
      {"method":"GET","path":"/api/search-text/<text>","desc":"Search text in disassembly","params":[{"name":"text","in":"path"}],"returns":"results[{ea,disasm,func}]"},
      {"method":"GET","path":"/api/bytes/<ea>/<size>","desc":"Read raw bytes","params":[{"name":"ea","in":"path"},{"name":"size","in":"path"}],"returns":"hex string"},
      {"method":"GET","path":"/api/vtable/<ea>","desc":"Read vtable entries","params":[{"name":"ea","in":"path"}],"returns":"entries[{index,ea,target,name}]"},
      {"method":"GET","path":"/api/global-vars","desc":"Global variables (non-function named data)","params":[],"returns":"global_vars[{ea,name,size}]"},
      {"method":"GET","path":"/api/bookmarks","desc":"IDA bookmarks","params":[],"returns":"bookmarks[{slot,ea,description}]"},
      {"method":"GET","path":"/api/patches","desc":"Patched bytes","params":[],"returns":"patches[{ea,original,patched}]"},
      {"method":"GET","path":"/api/gaps","desc":"Gaps between functions (undiscovered code)","params":[],"returns":"gaps[{start,end,size}]"},
      {"method":"GET","path":"/api/types","desc":"All local types","params":[],"returns":"types[{ordinal,name,type,size}]"},
      {"method":"GET","path":"/api/type/<name>","desc":"Type details with struct/union members","params":[{"name":"name","in":"path"}],"returns":"name, type, size, is_struct, members[]"},
      {"method":"GET","path":"/api/type-libraries","desc":"Loaded type libraries (TIL)","params":[],"returns":"libraries[{name,desc,ntypes}]"},
      {"method":"GET","path":"/api/insn/<ea>","desc":"Decoded instruction with operands","params":[{"name":"ea","in":"path"}],"returns":"ea, mnem, size, disasm, operands[{n,type,value,reg}]"},
      {"method":"GET","path":"/api/operands/<ea>","desc":"Operand details","params":[{"name":"ea","in":"path"}],"returns":"operands[{n,type,value,text}]"},
      {"method":"GET","path":"/api/data-xrefs/<ea>","desc":"Data cross-references only","params":[{"name":"ea","in":"path"}],"returns":"data_xrefs[{from,type,func}]"},
      {"method":"GET","path":"/api/code-xrefs/<ea>","desc":"Code cross-references only","params":[{"name":"ea","in":"path"}],"returns":"code_xrefs[{from,type,func}]"},
      {"method":"GET","path":"/api/cursor","desc":"Current cursor position in IDA","params":[],"returns":"ea, func, func_ea"},
      {"method":"GET","path":"/api/selection","desc":"Current selection range","params":[],"returns":"selected, start, end, size"},
      {"method":"GET","path":"/api/dbg/breakpoints","desc":"List breakpoints","params":[],"returns":"breakpoints[{ea,size,type,enabled,condition,pass_count,trace_only,hardware}]"},
      {"method":"GET","path":"/api/dbg/regs","desc":"Read CPU registers (debugger must be active)","params":[{"name":"tid","type":"int","optional":true},{"name":"all","type":"bool","optional":true}],"returns":"registers{name:hex_value}, details[], ip, sp"},
      {"method":"GET","path":"/api/dbg/threads","desc":"Thread list","params":[],"returns":"threads[{tid,name,is_current}], current_tid"},
      {"method":"GET","path":"/api/dbg/stack","desc":"Call stack trace","params":[],"returns":"stack[{caller,func,fp,symbol,module,offset}], ip, sp"},
      {"method":"GET","path":"/api/dbg/memory/<ea>/<size>","desc":"Read process memory (debugger)","params":[{"name":"ea","in":"path"},{"name":"size","in":"path"}],"returns":"ea, size, hex, ascii, pointers[]"},
      {"method":"GET","path":"/api/classes","desc":"List decompiler language-neutral classes (IDA 9.5+)","params":[{"name":"filter","type":"regex","optional":true},{"name":"toplevel","type":"bool","default":false},{"name":"hidden","type":"bool","default":false}],"returns":"classes[{id,name,rendered}], count"},
      {"method":"GET","path":"/api/class/<name>","desc":"Class members and rendered layout (IDA 9.5+)","params":[{"name":"name","in":"path"},{"name":"ea","type":"string","optional":true},{"name":"render","type":"bool","default":true},{"name":"no_bodies","type":"bool","default":false}],"returns":"name, id, rendered, members[]"},
      {"method":"GET","path":"/api/decompiler/timeout","desc":"Get Hex-Rays decompiler timeout in seconds (IDA 9.5+)","params":[],"returns":"timeout_seconds"},
      {"method":"GET","path":"/api/dbg/status","desc":"Comprehensive debugger state, IP/SP, current thread, module, instruction, and trace flags","params":[],"returns":"debugger_on, process_state, state_name, current_tid, ip, sp, current_module, current_func, current_insn, breakpoint_count, trace"},
      {"method":"GET","path":"/api/dbg/processes","desc":"List running processes visible to the active debugger backend","params":[],"returns":"processes[{pid,name}], count"},
      {"method":"GET","path":"/api/dbg/modules","desc":"List loaded modules/DLLs/shared objects in the debugged process","params":[],"returns":"modules[{name,base,size,end_ea,rebase_to}], count"},
      {"method":"GET","path":"/api/dbg/memory-map","desc":"Get live process virtual memory map with permissions","params":[],"returns":"regions[{start,end,size,name,sclass,bitness,perm}], count"},
      {"method":"GET","path":"/api/dbg/trace","desc":"Read recorded debugger trace events","params":[{"name":"count","type":"int","default":50},{"name":"offset","type":"int","default":0}],"returns":"events[{index,tev_type,tid,ea,func,disasm}], total"},
      {"method":"GET","path":"/api/dbg/exceptions","desc":"List configured debugger exception handling rules","params":[],"returns":"exceptions[{code,name,desc,break_on,handle,display_msg}], count"},
      {"method":"GET","path":"/api/dbg/events","desc":"Get buffered debugger hook events (breakpoints, exceptions, module/thread events)","params":[{"name":"limit","type":"int","default":50},{"name":"type","type":"string","optional":true}],"returns":"events[], count, total_buffered"},
      {"method":"GET","path":"/api/disasm-range","desc":"Disassemble an arbitrary address range without requiring a function","params":[{"name":"start","type":"string"},{"name":"end","type":"string","optional":true},{"name":"count","type":"int","default":100}],"returns":"start_ea, module_rva, instructions[{ea,disasm,bytes,size}], count"},
      {"method":"GET","path":"/api/dbg/breakpoints/export","desc":"Export all breakpoints with module+RVA, conditions, and actions as inline JSON","params":[],"returns":"version, count, breakpoints[]"},
      {"method":"GET","path":"/api/dbg/evidence","desc":"Capture inline JSON forensic/debugging evidence bundle (module, hashes, addresses, registers, stack, memory)","params":[{"name":"ea","type":"string","optional":true}],"returns":"binary, target, debugger, memory_ranges, notes"},
      {"method":"GET","path":"/api/instances","desc":"List active IDA Bridge instances across concurrent IDA processes","params":[],"returns":"instances[{port,url,pid,filename,filepath,token_path}], current_port, count"},
      {"method":"GET","path":"/api/function/<ea>/switch","desc":"Inspect switch/jump-table cases and target addresses","params":[{"name":"ea","in":"path"}],"returns":"ea, cases[{index,values,target}], count, default"},
      {"method":"GET","path":"/api/macro/analyze_context","desc":"Combined function analysis context (pseudocode, lvars, callers, callees, strings, xrefs, basic blocks)","params":[{"name":"ea","type":"string"}],"returns":"ea, name, pseudocode, lvars, callers, callees, strings, xrefs_to, basic_blocks"},
      {"method":"GET","path":"/api/schema","desc":"This schema (self-documenting API)","params":[],"returns":"this JSON object"},
      {"method":"GET","path":"/api/wait-analysis","desc":"Block until auto-analysis completes","params":[],"returns":"success"}
    ],
    "write": [
      {"method":"POST","path":"/api/function/<ea>/rename","desc":"Rename function","body":{"name":"string"}},
      {"method":"POST","path":"/api/function/<ea>/comment","desc":"Set function comment","body":{"comment":"string"}},
      {"method":"POST","path":"/api/function/<ea>/lvar-rename","desc":"Rename local variable","body":{"old":"string","new":"string"}},
      {"method":"POST","path":"/api/function/<ea>/lvar-set-type","desc":"Change local variable type","body":{"var":"variable_name","type":"C_type_string"}},
      {"method":"POST","path":"/api/function/<ea>/lvar-comment","desc":"Comment on local variable","body":{"var":"variable_name","comment":"string"}},
      {"method":"POST","path":"/api/function/<ea>/set-type","desc":"Set function prototype","body":{"type":"int __fastcall(int a1, char *a2)"}},
      {"method":"POST","path":"/api/address/<ea>/comment","desc":"Set inline comment","body":{"comment":"string"}},
      {"method":"POST","path":"/api/struct/create","desc":"Create struct from C definition","body":{"definition":"struct Foo { int x; char *name; };"}},
      {"method":"POST","path":"/api/struct/add-member","desc":"Add struct member","body":{"struct":"name","member":"field_name","offset":0,"size":4,"type":"optional"}},
      {"method":"POST","path":"/api/enum/create","desc":"Create enum","body":{"name":"string"}},
      {"method":"POST","path":"/api/enum/add-member","desc":"Add enum member","body":{"enum":"name","member":"member_name","value":0}},
      {"method":"POST","path":"/api/type/create","desc":"Create type from C declaration","body":{"definition":"typedef struct {...} MyType;"}},
      {"method":"POST","path":"/api/type/delete","desc":"Delete local type","body":{"name":"type_name"}},
      {"method":"POST","path":"/api/type-library/load","desc":"Load type information library","body":{"name":"ntapi"}},
      {"method":"POST","path":"/api/segment/create","desc":"Create new segment","body":{"start":"0x...","end":"0x...","name":"seg","class":"DATA","bitness":2}},
      {"method":"POST","path":"/api/segment/delete","desc":"Delete segment","body":{"ea":"0x..."}},
      {"method":"POST","path":"/api/segment/set-attrs","desc":"Modify segment attributes","body":{"ea":"0x...","name":"opt","class":"opt","perm":"rwx"}},
      {"method":"POST","path":"/api/set-name","desc":"Set name at any address","body":{"ea":"0x...","name":"string"}},
      {"method":"POST","path":"/api/set-color","desc":"Set address background color","body":{"ea":"0x...","color":"0x00FF00"}},
      {"method":"POST","path":"/api/make-func","desc":"Create function at address","body":{"ea":"0x..."}},
      {"method":"POST","path":"/api/delete-func","desc":"Delete function","body":{"ea":"0x..."}},
      {"method":"POST","path":"/api/patch-bytes","desc":"Patch bytes in binary","body":{"ea":"0x...","bytes":"90 90 90"}},
      {"method":"POST","path":"/api/make-code","desc":"Convert to code","body":{"ea":"0x..."}},
      {"method":"POST","path":"/api/make-data","desc":"Convert to data","body":{"ea":"0x...","size":4}},
      {"method":"POST","path":"/api/undefine","desc":"Undefine bytes","body":{"ea":"0x...","size":1}},
      {"method":"POST","path":"/api/apply-struct","desc":"Apply struct at address","body":{"ea":"0x...","struct":"name"}},
      {"method":"POST","path":"/api/delete-struct","desc":"Delete structure","body":{"name":"string"}},
      {"method":"POST","path":"/api/delete-enum","desc":"Delete enum","body":{"name":"string"}},
      {"method":"POST","path":"/api/add-bookmark","desc":"Add bookmark","body":{"ea":"0x...","description":"string"}},
      {"method":"POST","path":"/api/delete-bookmark","desc":"Delete bookmark","body":{"slot":0}},
      {"method":"POST","path":"/api/import-header","desc":"Import a C header from a directory configured in IDA_BRIDGE_ALLOWED_IMPORT_ROOTS","body":{"path":"C:/trusted/path/header.h"}},
      {"method":"POST","path":"/api/reanalyze","desc":"Force reanalysis of range","body":{"start":"0x...","end":"0x..."}},
      {"method":"POST","path":"/api/save","desc":"Save IDA database","body":{}},
      {"method":"POST","path":"/api/undo","desc":"Undo last action","body":{}},
      {"method":"POST","path":"/api/redo","desc":"Redo action","body":{}},
      {"method":"POST","path":"/api/navigate","desc":"Move cursor to address","body":{"ea":"0x..."}},
      {"method":"POST","path":"/api/batch","desc":"Prevalidate 1-256 mutations. dry_run previews without writes. Default rollback mode restores name/comment values on failure; inspect rollback results. rename-var, create-struct and set-type require best_effort mode without rollback","body":{"dry_run":false,"mode":"rollback","mutations":[{"op":"rename-func","ea":"0x...","name":"new_name"}]}},
      {"method":"POST","path":"/api/exec","desc":"Execute IDAPython with full SDK access when IDA_BRIDGE_ALLOW_EXEC=1. Use result dict to return data. Print statements are captured.","body":{"script":"import ida_funcs\nresult['count'] = ida_funcs.get_func_qty()"}},
      {"method":"POST","path":"/api/decompiler/timeout","desc":"Set Hex-Rays decompiler timeout in seconds (0=default, IDA 9.5+)","body":{"seconds":30}},
      {"method":"POST","path":"/api/dbg/load","desc":"Load debugger backend (win32, linux, macos, gdb, windbg, bochs, etc.) and optional remote target","body":{"name":"win32","remote":false,"host":"","port":0}},
      {"method":"POST","path":"/api/dbg/start","desc":"Start process in debugger (requires IDA_BRIDGE_ALLOW_DBG_START=1 or IDA_BRIDGE_ALLOW_EXEC=1)","body":{"path":"optional","args":"","sdir":"optional"}},
      {"method":"POST","path":"/api/dbg/exit","desc":"Terminate debugged process","body":{}},
      {"method":"POST","path":"/api/dbg/attach","desc":"Attach to process","body":{"pid":1234}},
      {"method":"POST","path":"/api/dbg/detach","desc":"Detach from process","body":{}},
      {"method":"POST","path":"/api/dbg/breakpoint","desc":"Set software or hardware breakpoint with optional condition, pass count, and trace-only mode","body":{"ea":"0x1000","hardware":false,"mode":"exec","size":1,"condition":"","pass_count":0,"trace_only":false,"enabled":true}},
      {"method":"POST","path":"/api/dbg/watchpoint","desc":"Set hardware data watchpoint (read, write, or rw) on memory range","body":{"ea":"0x1000","mode":"rw","size":4,"condition":"","pass_count":0,"trace_only":false,"enabled":true}},
      {"method":"POST","path":"/api/dbg/toggle-breakpoint","desc":"Enable or disable breakpoint at address","body":{"ea":"0x1000","enable":true}},
      {"method":"POST","path":"/api/dbg/update-breakpoint","desc":"Update condition, pass count, trace mode, or access mode on an existing breakpoint","body":{"ea":"0x1000","condition":"","pass_count":0,"trace_only":false,"enabled":true}},
      {"method":"POST","path":"/api/dbg/del-breakpoint","desc":"Delete breakpoint","body":{"ea":"0x..."}},
      {"method":"POST","path":"/api/dbg/step-into","desc":"Step into instruction (optional synchronous wait)","body":{"wait":false,"timeout":5}},
      {"method":"POST","path":"/api/dbg/step-over","desc":"Step over instruction (optional synchronous wait)","body":{"wait":false,"timeout":5}},
      {"method":"POST","path":"/api/dbg/step-out","desc":"Step until function return (optional synchronous wait)","body":{"wait":false,"timeout":5}},
      {"method":"POST","path":"/api/dbg/run-to","desc":"Run execution until target address (optional synchronous wait)","body":{"ea":"0x1000","wait":false,"timeout":5}},
      {"method":"POST","path":"/api/dbg/continue","desc":"Continue execution (optional synchronous wait)","body":{"wait":false,"timeout":5}},
      {"method":"POST","path":"/api/dbg/pause","desc":"Pause/suspend process","body":{}},
      {"method":"POST","path":"/api/dbg/wait","desc":"Wait synchronously for next debugger event","body":{"timeout":5,"wfne":1}},
      {"method":"POST","path":"/api/dbg/set-reg","desc":"Modify CPU register value in active debug session","body":{"reg":"rax","value":"0x0"}},
      {"method":"POST","path":"/api/dbg/write-memory","desc":"Write process memory","body":{"ea":"0x...","bytes":"90 90"}},
      {"method":"POST","path":"/api/dbg/refresh-memory","desc":"Refresh debugger memory layout and segmentation from live process","body":{}},
      {"method":"POST","path":"/api/dbg/search-memory","desc":"Search live process memory for byte pattern (hex with ?? wildcards) or string","body":{"pattern":"90 90","max_results":100}},
      {"method":"POST","path":"/api/dbg/thread-action","desc":"Select, suspend, or resume a thread by TID","body":{"tid":1,"action":"select"}},
      {"method":"POST","path":"/api/dbg/trace/configure","desc":"Enable/disable instruction, function, basic-block, or step tracing","body":{"insn":true,"func":false,"bblk":false,"step":false,"buf_size":10000}},
      {"method":"POST","path":"/api/dbg/trace/clear","desc":"Clear recorded trace buffer","body":{}},
      {"method":"POST","path":"/api/dbg/exceptions","desc":"Update exception handling configuration (break, pass to app, log)","body":{"code":3221225477,"break":true,"handle":false,"msg":true,"save":true}},
      {"method":"POST","path":"/api/dbg/events/clear","desc":"Clear buffered debugger hook event log","body":{}},
      {"method":"POST","path":"/api/decompile-batch","desc":"Batch decompile multiple functions to C pseudocode","body":{"addresses":["0x1000"],"format":"json"}},
      {"method":"POST","path":"/api/vtable/create-struct","desc":"Automatically generate a C vtable structure from virtual method pointers at address","body":{"ea":"0x1000","name":"MyVtable","max_entries":64}},
      {"method":"POST","path":"/api/dbg/breakpoints/export","desc":"Export all breakpoints with module+RVA, conditions, and actions to JSON file","body":{"output_path":""}},
      {"method":"POST","path":"/api/dbg/breakpoints/import","desc":"Import and restore breakpoints from list or JSON file using module+RVA across ASLR","body":{"breakpoints":[],"clear_existing":false}},
      {"method":"POST","path":"/api/dbg/evidence","desc":"Capture and optionally save JSON forensic/debugging evidence bundle","body":{"ea":"0x1000","memory_ranges":[],"stack_bytes":128}},
      {"method":"POST","path":"/api/dbg/cmd","desc":"Send raw command to underlying debugger backend (WinDbg/GDB) when IDA_BRIDGE_ALLOW_EXEC=1","body":{"cmd":"!peb"}},
      {"method":"POST","path":"/api/dbg/appcall","desc":"Execute target function via IDA Appcall in suspended process when IDA_BRIDGE_ALLOW_EXEC=1","body":{"ea":"0x1000","proto":"int __fastcall(int a1)","args":[1]}}
    ]
  },
  "workflows": [
    {
      "name": "Analyze unknown binary",
      "steps": [
        "GET /api/info — understand target architecture",
        "GET /api/strings — scan for interesting strings",
        "GET /api/imports — check imported APIs for clues",
        "GET /api/exports — find entry points",
        "GET /api/functions-page?offset=0&limit=100 — browse functions",
        "GET /api/function/<ea>/pseudocode — decompile interesting functions",
        "GET /api/function/<ea>/strings-used — check what strings a function uses",
        "POST /api/batch — rename and comment in bulk"
      ]
    },
    {
      "name": "Trace specific functionality",
      "steps": [
        "GET /api/strings?filter=keyword — find related strings",
        "GET /api/function/<ea>/xrefs-to — find who references the string",
